# ─── Azure OpenAI ──────────────────────────────────────────────────────────────
# Resource name only — no https://, no .openai.azure.com suffix.
# For endpoint https://aafr-studio-resource.openai.azure.com → use: aafr-studio-resource
AZURE_OPENAI_RESOURCE_NAME=aafr-studio-resource

# Your Azure OpenAI API key — get this from the Azure portal
AZURE_OPENAI_API_KEY=<YOUR_API_KEY_HERE>

# The deployment name in your Azure OpenAI resource
AZURE_OPENAI_DEPLOYMENT=gpt-5.6-luna

# ─── MongoDB Atlas ─────────────────────────────────────────────────────────────
# MongoDB Atlas connection string (recommended).
# Steps to get this:
#   1. Go to https://cloud.mongodb.com → your cluster → Connect → Drivers → Node.js
#   2. Copy the connection string and replace <username> and <password>
#   3. The database "insurance_db" is created automatically on first write
#
# Atlas format:
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority&appName=<appName>
MONGODB_DB_NAME=insurance_db
#
# Leave MONGODB_URI blank to fall back to built-in in-memory mock data (no DB needed):
# MONGODB_URI=

# ─── Cerbos PDP ────────────────────────────────────────────────────────────────
# Start with: docker-compose up -d
# Health check: curl http://localhost:3592/_cerbos/health
CERBOS_URL=http://localhost:3592

# ─── MongoDB MCP Server (Pattern 3) ────────────────────────────────────────────
# The HTTP endpoint of mongodb-mcp-server started by docker-compose.
# Leave blank to bypass Pattern 3 and use the direct MongoDB driver instead.
MDB_MCP_SERVER_URL=http://localhost:4000/mcp

# ─── Session Security ──────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
SESSION_SECRET=change-me-to-a-random-32-plus-character-string-in-production
